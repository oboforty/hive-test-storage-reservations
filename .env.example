# DEBUG | TESTING | PROD
#   DEBUG   - every log level to both log file and stdout/stderr
#   TESTING - log file gets everything, stdout/stderr gets info and above
#   PROD    - log file gets info and above, stderr gets errors only, no stdout
ENV=DEBUG

HTTP_ADDR=:8080
DB_PATH=data/hive.db
LOG_FILE=logs/app.log

# Go durations (e.g. 500ms, 15s, 1m)
SHUTDOWN_TIMEOUT=15s
REQUEST_TIMEOUT=30s
# how long X-Dedup-ID responses are kept and replayed (0 = forever)
DEDUP_TTL=24h

# Default max_parallel_chunks for new accounts, resolved in this order:
#   1. HIVE_SETTINGS_FILE (json: {"default_max_parallel_chunks": N})
#   2. GET HIVE_API (reads its MAX_PARALLEL_CHUNKS field; cached into HIVE_SETTINGS_FILE)
#   3. ACCOUNT_MAX_CHUNKS_DEFAULT
HIVE_SETTINGS_FILE=hivesettings.json
HIVE_API=
ACCOUNT_MAX_CHUNKS_DEFAULT=5

# Max requests per second per client IP (0 = disabled)
RATE_LIMIT=10
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted
# for the client IP, e.g. 127.0.0.1/32,10.0.0.0/8. Empty = use the TCP peer.
TRUSTED_PROXIES=
