meta {
  name: Get Account
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/accounts/{{accountId}}
  body: none
  auth: none
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns the requested account", function() {
    expect(res.getBody().id).to.equal(bru.getVar("accountId"));
  });
}
